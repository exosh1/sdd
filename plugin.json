{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "sdd",
  "version": "2.4.1",
  "description": "Spec-Driven Development for GitHub Copilot: 23 atomic, stack-agnostic skills and 10 custom agents to take features from discovery through design, implementation, review, and release.",
  "author": {
    "name": "Kyrylo Genkov",
    "url": "https://github.com/genkovich"
  },
  "homepage": "https://github.com/exosh1/sdd",
  "repository": "https://github.com/exosh1/sdd",
  "license": "MIT",
  "keywords": [
    "sdd",
    "spec-driven-development",
    "github-copilot",
    "agent-skills",
    "agents",
    "tdd"
  ],
  "extensions": {
    "com.github.copilot": {
      "agents": [
        "./com.github.copilot/agents/sdd-analyst.agent.md",
        "./com.github.copilot/agents/sdd-critic.agent.md",
        "./com.github.copilot/agents/sdd-devils-advocate.agent.md",
        "./com.github.copilot/agents/sdd-explorer.agent.md",
        "./com.github.copilot/agents/sdd-implementer.agent.md",
        "./com.github.copilot/agents/sdd-pen-keeper.agent.md",
        "./com.github.copilot/agents/sdd-researcher.agent.md",
        "./com.github.copilot/agents/sdd-reviewer.agent.md",
        "./com.github.copilot/agents/sdd-strategist.agent.md",
        "./com.github.copilot/agents/sdd-test-author.agent.md"
      ]
    }
  }
}
